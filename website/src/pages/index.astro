---
import Page from '../layouts/Page.astro';
import Map from '../components/Map.astro';
import {stations,number} from '../lib/snapshot.mjs';
const rows = stations(), states = [...new Set(rows.map(r=>r.state))].sort();
---
<Page title="Station directory">
  <h1>Public radio stations</h1>
  <p class="intro">Explore the residents and households within the modeled FM service area of each station on the public-radio roster. These are residential estimates, not listener counts.</p>
  <form id="filters" class="filters" hidden>
    <label>Find a station<input type="search" id="search" placeholder="Call sign, city, licensee or owner" /></label>
    <label>State or territory<select id="state"><option value="">All locations</option>{states.map(s=><option>{s}</option>)}</select></label>
    <label>Data available<select id="availability"><option value="">All entries</option><option value="reach">Resident estimate</option><option value="missing">No estimate</option></select></label>
  </form>
  <p id="count" role="status">{rows.length} roster entries</p>
  <Map directory label="Transmitters matching the station filters" />
  <p class="note">Points show transmitter sites with eligible contours. Select a point or station name for its footprint and demographics. Alaska, Hawaii and territories can be located with the location filter.</p>
  <h2>Station results</h2>
  <div class="scroll"><table id="directory"><thead><tr><th scope="col">Station</th><th scope="col">Location</th><th scope="col">Licensee on roster</th><th scope="col" class="num">2020 resident reach</th></tr></thead><tbody>
  {rows.map(r=><tr data-id={r.id} data-name={r.name} data-state={r.state} data-owner={r.owner_name??''} data-has={r.residents!=null?'reach':'missing'} data-lat={r.lat} data-lon={r.lon}>
    <th scope="row"><a id={`link-${r.id}`} href={`/stations/${r.id}/`}>{r.name}</a></th><td>{r.city}, {r.state}</td><td>{r.licensee||'Unknown'}</td><td class="num">{number(r.residents)}</td>
  </tr>)}</tbody></table></div>
  <nav class="pager" id="pager" aria-label="Station result pages" hidden><button id="prev">Previous</button><span id="position"></span><button id="next">Next</button></nav>
</Page>
<script>
  const form = document.querySelector<HTMLFormElement>('#filters')!;
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const state = document.querySelector<HTMLSelectElement>('#state')!;
  const available = document.querySelector<HTMLSelectElement>('#availability')!;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#directory tbody tr')];
  const prev = document.querySelector<HTMLButtonElement>('#prev')!, next = document.querySelector<HTMLButtonElement>('#next')!;
  const size=30;
  let page=0, matched=rows;
  function paginate() {
    const pages=Math.max(1, Math.ceil(matched.length/size));
    const visible=new Set(matched.slice(page*size,(page+1)*size));
    rows.forEach(r=>r.hidden=!visible.has(r));
    prev.disabled=page===0; next.disabled=page+1>=pages;
    document.querySelector('#position')!.textContent=`Page ${page+1} of ${pages}`;
    document.querySelector<HTMLElement>('#pager')!.hidden=pages===1;
  }
  function filter(updateURL:boolean) {
    const term=search.value.trim().toLowerCase();
    matched=rows.filter(r=>(!state.value||r.dataset.state===state.value) &&
      (!available.value||available.value===r.dataset.has) &&
      (!term||`${r.dataset.name} ${r.cells[1].textContent} ${r.cells[2].textContent} ${r.dataset.owner}`.toLowerCase().includes(term)));
    page=0; paginate();
    const mapped=matched.filter(r=>r.dataset.lat && r.dataset.lon);
    document.querySelector('#count')!.textContent=`${matched.length} matching stations · ${mapped.length} mapped`;
    const points=document.querySelector('leaflet-geojson')!;
    points.data={type:'FeatureCollection',features:mapped.map(r=>({type:'Feature',id:r.dataset.id,
      properties:{name:r.dataset.name}, geometry:{type:'Point',coordinates:[Number(r.dataset.lon),Number(r.dataset.lat)]}}))};
    const map=document.querySelector('leaflet-map')?.map;
    if(map && (term||state.value||available.value) && mapped.length) {
      map.fitBounds(mapped.map(r=>[Number(r.dataset.lat),Number(r.dataset.lon)] as [number,number]),{maxZoom:9,padding:[16,16],animate:false});
    } else if(map && mapped.length) map.setView([38,-96],4,{animate:false});
    if(updateURL) {
      const url=new URL(location.href);
      for(const [k,v] of [['q',search.value],['state',state.value],['data',available.value]]) v?url.searchParams.set(k,v):url.searchParams.delete(k);
      history.replaceState(null,'',url);
    }
  }
  const initial=new URLSearchParams(location.search);
  search.value=initial.get('q')??''; state.value=initial.get('state')??''; available.value=initial.get('data')??'';
  form.hidden=false;
  form.addEventListener('submit',e=>{e.preventDefault();filter(true)});
  form.addEventListener('input',()=>filter(true));
  prev.addEventListener('click',()=>{page--;paginate()}); next.addEventListener('click',()=>{page++;paginate()});
  filter(false);
  customElements.whenDefined('leaflet-map').then(async()=>{
    await document.querySelector('leaflet-map')!.whenReady; filter(false);
  });
</script>
